
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HOMEOWNER
  SALES
  ADMIN
}

enum Ownership {
  OWNER
  TENANT
}

enum RoofType {
  RCC
  METAL_SHEET
  ASBESTOS
  OTHER
}

enum LeadScore {
  HIGH
  MEDIUM
  LOW
}

enum LeadStatus {
  NEW
  BILL_REVIEW
  REUPLOAD_REQUESTED
  SURVEY
  CALL_ONLY
  QUOTED
  WON
  LOST
}

enum BillStatus {
  UPLOADED
  EXTRACTED
  NEEDS_REUPLOAD
  CONFIRMED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum ProjectStage {
  ADVANCE_PAID
  SURVEY_DONE
  INSTALLATION
  NET_METERING
  SUBSIDY_APPLIED
  SUBSIDY_CREDITED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(HOMEOWNER)
  language     String   @default("en")
  createdAt    DateTime @default(now())

  leads         Lead[]         @relation("LeadOwner")
  assignedLeads Lead[]         @relation("LeadAssignee")
  quotes        Quote[]
  billsVerified Bill[]
  events        ProjectEvent[]
}

model Lead {
  id            String     @id @default(cuid())
  code          String     @unique
  name          String
  phone         String
  ownership     Ownership
  roofType      RoofType
  roofAreaSqft  Int
  monthlyBill   Int
  pincode       String
  district      String?
  status        LeadStatus @default(NEW)
  score         LeadScore?
  scoreReasons  Json?
  recommendedKw Float?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  homeownerId  String?
  homeowner    User?   @relation("LeadOwner", fields: [homeownerId], references: [id])
  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id])

  bills   Bill[]
  quotes  Quote[]
  project Project?

  @@index([status, score])
}

model Bill {
  id               String     @id @default(cuid())
  leadId           String
  lead             Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  imagePath        String?
  fileData         Bytes?
  fileMime         String?
  fileSize         Int?
  status           BillStatus @default(UPLOADED)
  aiExtraction     Json?
  aiModel          String?
  aiError          String?
  aiIssues         Json?
  reuploadReason   String?
  billAmount       Int?
  consumerNumber   String?
  tariffCategory   String?
  sanctionedLoadKw Float?
  monthlyUnits     Int?
  verifiedById     String?
  verifiedBy       User?      @relation(fields: [verifiedById], references: [id])
  verifiedAt       DateTime?
  createdAt        DateTime   @default(now())
}

model PriceRule {
  id            String    @id @default(cuid())
  minKw         Float
  maxKw         Float
  pricePerKw    Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  note          String?
  createdAt     DateTime  @default(now())
}

model SubsidyRule {
  id            String    @id @default(cuid())
  name          String
  slabs         Json
  capAmount     Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  note          String?
  createdAt     DateTime  @default(now())
}

model CalcSetting {
  id                  String    @id @default(cuid())
  generationPerKwYear Int
  tariffPerUnit       Float
  exportRatePerUnit   Float
  sqftPerKw           Int
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  createdAt           DateTime  @default(now())
}

model Quote {
  id               String      @id @default(cuid())
  code             String      @unique
  leadId           String
  lead             Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdById      String
  createdBy        User        @relation(fields: [createdById], references: [id])
  status           QuoteStatus @default(DRAFT)
  systemKw         Float
  grossCost        Int
  subsidy          Int
  netCost          Int
  annualGeneration Int
  annualSavings    Int
  paybackYears     Float
  snapshot         Json
  createdAt        DateTime    @default(now())

  project Project?
}

model Project {
  id           String       @id @default(cuid())
  leadId       String       @unique
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quoteId      String       @unique
  quote        Quote        @relation(fields: [quoteId], references: [id])
  stage        ProjectStage @default(ADVANCE_PAID)
  statusToken  String       @unique
  stageUpdated DateTime     @default(now())
  createdAt    DateTime     @default(now())

  events        ProjectEvent[]
  notifications Notification[]
}

model ProjectEvent {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     ProjectStage
  note      String?
  byId      String?
  by        User?        @relation(fields: [byId], references: [id])
  at        DateTime     @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel   String
  to        String
  body      String
  status    String   @default("MOCK_SENT")
  createdAt DateTime @default(now())
}
